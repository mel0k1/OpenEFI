{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenEFI",
  "version": "0.2.0",
  "identifier": "com.mel0k1.openefi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenEFI \u2014 \u0441\u0431\u043e\u0440\u043a\u0430 EFI \u0434\u043b\u044f \u0445\u0430\u043a\u0438\u043d\u0442\u043e\u0448\u0430",
        "width": 1100,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
